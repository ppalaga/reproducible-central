groupId=jakarta.el
artifactId=jakarta.el-api
display=${groupId}:${artifactId}
version=6.0.1

gitRepo=https://github.com/jakartaee/expression-language.git
gitTag=${version}-RELEASE-api

tool=mvn-3.9.11
jdk=17
newline=lf
#umask=022

command="mvn clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -f api/pom.xml"
buildinfo=api/target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
